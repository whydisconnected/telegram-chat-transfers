+            invalidate();
+        }
+        @Override protected void onDraw(Canvas canvas) {
+            long now = android.os.SystemClock.uptimeMillis();
+            float release = pressed ? 0 : Math.min(1, (now - releasedAt) / 280f);
+            if (release >= 1) return;
+            float entry = Math.min(1, (now - downAt) / 140f);
+            float radius = AndroidUtilities.dpf2((17 + release * 9) * (.65f + .35f * entry));
+            int color = Color.WHITE;
+            paint.setStyle(Paint.Style.FILL); paint.setColor(color); paint.setAlpha((int) (45 * (1 - release)));
+            canvas.drawCircle(x, y, radius, paint);
+            paint.setColor(Color.WHITE); paint.setAlpha((int) (180 * (1 - release)));
+            paint.setStyle(Paint.Style.STROKE); paint.setStrokeWidth(AndroidUtilities.dpf2(1.2f));
