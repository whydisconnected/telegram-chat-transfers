+    /** Local transport fixture. Every progress indicator and check is drawn by
+     * the upstream ChatMessageCell, with the same message state as a real upload. */
+    private void simulateLocalUpload(MessageObject.GroupedMessages group) {
+        final long started = android.os.SystemClock.uptimeMillis();
+        getChatListView().postDelayed(new Runnable() {
+            @Override public void run() {
+                if (isFinished || getChatListView() == null) return;
+                float progress = Math.min(1f, (android.os.SystemClock.uptimeMillis() - started) / 2400f);
+                for (int i = 0; i < getChatListView().getChildCount(); i++) {
+                    View child = getChatListView().getChildAt(i);
+                    if (!(child instanceof ChatMessageCell)) continue;
+                    ChatMessageCell cell = (ChatMessageCell) child;
+                    MessageObject message = cell.getMessageObject();
+                    if (!group.messages.contains(message)) continue;
+                    long size = new java.io.File(message.messageOwner.attachPath).length();
+                    cell.onProgressUpload(message.messageOwner.attachPath, (long) (size * progress), size, false);
+                }
+                if (progress < 1f) getChatListView().postDelayed(this, 50);
+                else {
+                    for (MessageObject message : group.messages) {
+                        message.messageOwner.send_state = MessageObject.MESSAGE_SEND_STATE_SENT;
+                        // Keep unread: sending successfully does not imply the recipient saw it.
+                        message.messageOwner.unread = true;
+                    }
+                    for (int i = 0; i < getChatListView().getChildCount(); i++) {
+                        if (!(getChatListView().getChildAt(i) instanceof ChatMessageCell)) continue;
+                        ChatMessageCell cell = (ChatMessageCell) getChatListView().getChildAt(i);
+                        if (group.messages.contains(cell.getMessageObject())) {
+                            cell.updateButtonState(false, true, false);
+                            cell.invalidate();
+                        }
+                    }
+                    getChatListView().invalidate();
+                    android.util.Log.d("ChatTransfer", "albumState=sent_unread");
+                }
+            }
+        }, 80);
+    }
