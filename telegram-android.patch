+                @Override public boolean onPreDraw() {
+                    getChatListView().getViewTreeObserver().removeOnPreDrawListener(this);
+                    for (int j = 0; j < getChatListView().getChildCount(); j++) {
+                        View child = getChatListView().getChildAt(j);
+                        if (!(child instanceof ChatMessageCell)) continue;
+                        ChatMessageCell cell = (ChatMessageCell) child;
+                        Bitmap bitmap = readyImages.get(cell.getMessageObject().getId());
+                        if (bitmap != null) cell.getPhotoImage().setImageBitmap(bitmap);
+                    }
+                    return true;
+                }
+            });
