+                java.io.File file = fixture.photo(order.get(i));
+                BitmapFactory.Options dimensions = new BitmapFactory.Options(); dimensions.inJustDecodeBounds = true;
+                BitmapFactory.decodeFile(file.getAbsolutePath(), dimensions);
+                TLRPC.TL_photoSize size = new TLRPC.TL_photoSize(); size.type = "x";
+                size.w = dimensions.outWidth; size.h = dimensions.outHeight; size.size = (int) file.length();
+                size.location = new TLRPC.TL_fileLocationToBeDeprecated(); size.location.volume_id = Integer.MIN_VALUE;
+                size.location.local_id = -localSequence++;
+                java.nio.file.Files.copy(file.toPath(), getFileLoader().getPathToAttach(size, true).toPath(),
+                        java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+                TLRPC.TL_photo photo = new TLRPC.TL_photo(); photo.id = localSequence++;
+                photo.file_reference = new byte[0]; photo.sizes.add(size);
+                TLRPC.TL_message msg = new TLRPC.TL_message(); msg.id = -localSequence++; msg.out = true;
+                msg.send_state = MessageObject.MESSAGE_SEND_STATE_SENDING;
+                msg.unread = true;
+                msg.flags = 768 | (order.size() > 1 ? 131072 : 0); msg.grouped_id = order.size() > 1 ? group.groupId : 0;
+                msg.date = 1791916980; msg.dialog_id = fixtureUser; msg.attachPath = file.getAbsolutePath();
+                msg.from_id = new TLRPC.TL_peerUser(); msg.peer_id = new TLRPC.TL_peerUser(); msg.peer_id.user_id = fixtureUser;
+                msg.message = i == 0 ? caption : ""; msg.media = new TLRPC.TL_messageMediaPhoto();
+                msg.media.flags = 1; msg.media.photo = photo;
+                MessageObject object = new MessageObject(currentAccount, msg, true, false);
+                object.stableId = msg.id;
+                readyImages.put(msg.id, BitmapFactory.decodeFile(file.getAbsolutePath()));
+                object.mediaExists = object.attachPathExists = true;
+                group.messages.add(object);
+            }
+            // Use the complete upstream new-message path: grouping, stable IDs,
+            // insertion notifications, scrolling and native entrance animation.
+            // Only message data/transport come from this signed-out fixture.
+            super.didReceivedNotification(NotificationCenter.didReceiveNewMessages,
+                    currentAccount, fixtureUser, new ArrayList<>(group.messages), false, 0);
