+    @Override public boolean onBackPressed(boolean invoked) {
+        if (invoked && nativeChrome != null && nativeChrome.closeArtwork()) return false;
+        if (invoked && interactions != null && interactions.back()) return false;
+        return super.onBackPressed(invoked);
+    }
