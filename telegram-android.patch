+            try { org.telegram.messenger.ApplicationLoader.applicationContext.unregisterReceiver(captureControl); }
+            catch (Exception ignored) { }
+            captureControl = null;
+        }
+        if (nativeChrome != null) nativeChrome.dispose();
+        if (interactions != null) interactions.dispose();
+        super.onFragmentDestroy();
+        if (fixture != null) fixture.close();
+        if (previousTheme != null) Theme.applyTheme(previousTheme, false, true);
+    }
