+                paint.setColor(color); paint.setAlpha(210); paint.setStrokeWidth(AndroidUtilities.dpf2(2));
+                float r = radius + AndroidUtilities.dp(4);
+                canvas.drawArc(x-r, y-r, x+r, y+r, -90, hold * 360, false, paint);
+            }
+            postInvalidateOnAnimation();
+        }
+    }
