+package org.telegram.ui.Components;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Local interaction model. Transport and audio playback are supplied by the host. */
+public final class ChatTransferState {
+    public final ArrayList<Integer> selected = new ArrayList<>();
+    public final ArrayList<Integer> attachments = new ArrayList<>();
+    public final ArrayList<Integer> next = new ArrayList<>();
+    public int current;
+    public boolean playing = true;
+
+    public boolean enqueue(int track) {
+        if (track < 0 || track == current || next.contains(track)) return false;
+        next.add(track);
+        return true;
+    }
+
+    public void playNext() {
+        if (!next.isEmpty()) current = next.remove(0);
+    }
+
+    public void select(int photo) {
+        if (photo < 0) return;
+        if (selected.contains(photo)) selected.remove((Integer) photo);
+        else if (!attachments.contains(photo)) selected.add(photo);
+    }
+
+    public void stageSelection(int heldPhoto) {
+        if (selected.isEmpty() && heldPhoto >= 0) selected.add(heldPhoto);
+        for (int photo : selected) if (!attachments.contains(photo)) attachments.add(photo);
+        selected.clear();
+    }
+
+    public void move(int from, int to) {
+        if (from < 0 || from >= attachments.size() || to < 0 || to >= attachments.size() || from == to) return;
+        attachments.add(to, attachments.remove(from));
+    }
+
+    public void remove(int photo) { attachments.remove((Integer) photo); }
+
+    public List<Integer> takeAlbum() {
+        List<Integer> result = Collections.unmodifiableList(new ArrayList<>(attachments));
+        attachments.clear();
+        return result;
+    }
+}
