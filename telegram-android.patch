+    private void applyArtwork(float value) {
+        artworkProgress = value;
+        float p = Math.max(0, Math.min(1, value));
+        player.setMusicExpansion(p);
+        FrameLayout.LayoutParams closeParams = (FrameLayout.LayoutParams) nativeClose.getLayoutParams();
+        closeParams.width = closeParams.height = AndroidUtilities.dp(36 - 12 * p);
+        closeParams.topMargin = AndroidUtilities.dp(4 * p);
+        nativeClose.setLayoutParams(closeParams);
+        // Artwork and both metadata lines enter as a single, anchored group.
+        // A critically damped container avoids a second bounce in this content.
+        float contentAlpha = Math.max(0, Math.min(1, (p - .12f) / .70f));
+        contentAlpha = contentAlpha * contentAlpha * (3 - 2 * contentAlpha);
+        float nativeAlpha = Math.max(0, 1 - p / .45f);
+        nativeClose.setAlpha(nativeAlpha); nativeClose.setEnabled(p < .5f);
+        normalPlay.setAlpha(nativeAlpha); normalPlay.setEnabled(p < .5f);
+        nativeTitle.setAlpha(nativeAlpha);
+        nativeTitle.setTranslationX(titleTranslationX);
+        nativeTitle.setPadding(titlePaddingLeft, titlePaddingTop, titlePaddingRight, titlePaddingBottom);
+        for (View view : new View[]{artwork, artworkPlay, expandedTitle, expandedArtist, inlineSeek, elapsed, duration, inlineNext}) {
+            view.setVisibility(p > .001f ? View.VISIBLE : View.INVISIBLE);
+            view.setAlpha(contentAlpha); view.setEnabled(p > .8f);
+            view.setTranslationY(AndroidUtilities.dp(6) * (1 - p));
+            view.setTranslationX(0);
+        }
+        artwork.setPivotX(artwork.getWidth() * .5f);
+        artwork.setPivotY(artwork.getHeight() * .5f);
+        artwork.setScaleX(.92f + .08f * p);
+        artwork.setScaleY(.92f + .08f * p);
+    }
